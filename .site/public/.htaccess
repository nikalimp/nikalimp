# HTTP → HTTPS — галочкой в ISPmanager («Перенаправлять HTTP-запросы в HTTPS»), не здесь:
# nginx снимает TLS перед Apache, правило по %{SERVER_PORT}/%{HTTPS} грозит бесконечным циклом («Хостинги — что проверено»).

# www → https://nikalimp.ru одним редиректом (7.11.2026, Search Console: Google выбирал www-адреса главными).
# Условие по имени хоста, не по порту/HTTPS — цикла за nginx не будет.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.nikalimp\.ru$ [NC]
  RewriteRule ^(.*)$ https://nikalimp.ru/$1 [R=301,L]
</IfModule>

# Защитные заголовки (HSTS включается галочкой в ISPmanager). IfModule — чтобы без mod_headers сайт не падал с 500.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Кодировка для llms.txt, robots.txt, sitemap.xml
AddDefaultCharset UTF-8
AddCharset UTF-8 .txt .xml .html

# Старые адреса (транслит) → новые. Список — scripts/redirects.json.
# Работает, только если на хостинге включён Apache: nginx .htaccess не читает.
# Коллекция сайтов переехала с /tilda-sites/ (7.11.2026, адреса успели уйти в IndexNow)
RedirectMatch 301 ^/tilda-sites/(.*)$ https://nikalimp.ru/sites/$1
